{
  "manifest_version": 3,
  "name": "StudyTube Filter (Atlas)",
  "version": "0.1.0",
  "description": "学習テーマに関連する動画タイトルだけ表示し、それ以外のYouTubeレコメンドを非表示にする",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.youtube.com/*", "https://api.openai.com/*"],
  "action": {
    "default_title": "StudyTube Filter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
